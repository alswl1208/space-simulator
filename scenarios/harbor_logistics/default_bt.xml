<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="space-simulator">
    <Sequence>
      <Fallback>
        <IsBatterySufficient/>
        <Sequence>
          <Fallback>
            <IsArrivedAtChargingStation/>
            <Sequence>
              <Fallback>
                <Sequence>
                  <PlanPath goal_type="charging_station"/>
                  <IsPathBlocked/>
                </Sequence>
                <PlanPath goal_type="charging_station"/>
              </Fallback>
              <GoToChargingStation/>
            </Sequence>
          </Fallback>
          <ChargeBattery/>
        </Sequence>
      </Fallback>
      <Sequence>
        <LocalSensingNode/>
        <Fallback>
          <IsFinishedTask/>
          <Sequence>
            <Fallback>
              <IsHoldingItem/>
              <Sequence>
                <Fallback>
                  <IsArrivedAtShip/>
                  <Sequence>
                    <DecideShip/>
                    <Fallback>
                      <Sequence>
                        <PlanPath goal_type="ship"/>
                        <IsPathBlocked/>
                        <Fallback>
                          <IsFlowStable/>
                          <Sequence>
                            <ControlGroupFlow/>
                            <IsMyTurnToGo/>
                          </Sequence>
                        </Fallback>
                      </Sequence>
                      <PlanPath goal_type="ship"/>
                    </Fallback>
                    <GoToShip/>
                  </Sequence>
                </Fallback>
                <PickItem/>
              </Sequence>
            </Fallback>
            <Fallback>
              <IsArrivedAtDestination/>
              <Sequence>
                <Fallback>
                  <Sequence>
                    <PlanPath goal_type="destination"/>
                    <IsPathBlocked/>
                  </Sequence>
                  <PlanPath goal_type="destination"/>
                </Fallback>
                <GoToDestination/>
              </Sequence>
            </Fallback>
            <PlaceItem/>
          </Sequence>
        </Fallback>
      </Sequence>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="PlanPath"
            editable="true">
        <input_port name="goal_type" description="The type of goal (ship, destination, charging_station)"/>
    </Action>  
    <Action ID="GoToDestination"
            editable="true"/>
    <Action ID="DecideShip"
            editable="true"/>
    <Action ID="GoToShip"
            editable="true"/>
    <Condition ID="IsArrivedAtDestination"
               editable="true"/>
    <Condition ID="IsArrivedAtShip"
               editable="true"/>
    <Condition ID="IsArrivedAtChargingStation"
               editable="true"/>
    <Condition ID="IsFinishedTask"
               editable="true"/>
    <Condition ID="IsHoldingItem"
               editable="true"/>
    <Condition ID="IsPathBlocked"
               editable="true"/>
    <Condition ID="IsFlowStable"
               editable="true"/>
    <Condition ID="IsMyTurnToGo"
               editable="true"/>
    <Action ID="LocalSensingNode"
            editable="true"/>
    <Action ID="PickItem"
            editable="true"/>
    <Action ID="PlaceItem"
            editable="true"/>
    <Action ID="ControlGroupFlow"
            editable="true"/>
    <Condition ID="IsBatterySufficient"
               editable="true"/>
    <Action ID="GoToChargingStation"
            editable="true"/>
    <Action ID="ChargeBattery"
            editable="true"/>
  </TreeNodesModel>

</root>
